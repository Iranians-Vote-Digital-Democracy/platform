# Environment files with secrets
.env
!.env.example

# Matrix / Synapse / MAS runtime secrets — never commit the real files
configs/synapse/homeserver.yaml
configs/synapse/*.signing.key
configs/synapse/*.log.config
configs/mas/config.yaml
# .example versions ARE committed (no secrets, just templates)
!configs/synapse/homeserver.yaml.example
!configs/mas/config.yaml.example

# Node.js
node_modules/
npm-debug.log*

# Hardhat
.cache/
services/passport-contracts/scripts
services/passport-voting-contracts/scripts
scripts/
# Exception: sso-svc scripts/ holds permanent smoke runners (fake-wallet.js)
!services/sso-svc/scripts/
!services/sso-svc/scripts/**
artifacts/
generated-types/

# Build outputs
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
coverage/
coverage.json

# Temporary files
tmp/
temp/
deploy/.env.example
deploy/.env.example
