# Environment files with secrets
.env
!.env.example

# Matrix / Synapse / MAS runtime secrets — never commit the real files
configs/synapse/homeserver.yaml
configs/synapse/*.signing.key
configs/synapse/*.log.config
configs/mas/config.yaml
# .example versions ARE committed (no secrets, just templates)
!configs/synapse/homeserver.yaml.example
!configs/mas/config.yaml.example

# Node.js
node_modules/
npm-debug.log*

# Hardhat
.cache/
# Ignore everything under contract scripts/ dirs (debug clutter), except the
# specific files a fresh dev needs to bootstrap local Hardhat. We exclude
# directory CONTENTS (/*) rather than the directory itself, so the negations
# below can re-include individual files.
services/passport-contracts/scripts/*
services/passport-voting-contracts/scripts/*
scripts/
# Exception: sso-svc scripts/ holds permanent smoke runners (fake-wallet.js)
!services/sso-svc/scripts/
!services/sso-svc/scripts/**
# Exception: minimum scripts a fresh dev needs (see
# .github/copilot-instructions.md "Quick Reference"). We re-include the parent
# dir, re-exclude its contents, then allowlist specific files.
!services/passport-contracts/scripts/
!services/passport-voting-contracts/scripts/
!services/passport-contracts/scripts/deploy-mock-evidence-registry.js
!services/passport-contracts/scripts/verify-local-setup.js
!services/passport-contracts/scripts/advance-time.js
!services/passport-contracts/scripts/redeploy-inid-honk.js
!services/passport-voting-contracts/scripts/create-test-proposals.js
!services/passport-voting-contracts/scripts/deploy-idcard-voting.js
!services/passport-voting-contracts/scripts/diff-public-signals.ts
artifacts/
generated-types/

# Build outputs
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
coverage/
coverage.json

# Temporary files
# Debug artifacts
curl_payload*.json
trace*.txt
*.poseidon-bak/
tmp/
temp/
deploy/.env.example
# Local debug helper scripts
services/passport-contracts/fix.js
services/passport-contracts/make_payload.js
deploy/.env.example
