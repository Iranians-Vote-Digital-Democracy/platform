# Local dev overrides — never commit real secrets
# Copy to .env and fill in values before running locally.

SSO_DB_URL=postgres://sso:sso@localhost:5433/sso?sslmode=disable

# Canonical issuer origin (no trailing slash). Used as the iss claim in
# ID tokens and as the base for .well-known/openid-configuration.
# Local dev: http://localhost:8000
# Production:  https://sso.jomhoor.org
SSO_OIDC_ISSUER=http://localhost:8000

# RS256 signing keypair (Phase 1.1).
# Generate with: scripts/generate-jwt-keypair.sh <kid>
# The script prints export lines you can paste here.
SSO_JWT_CURRENT_KID=
SSO_JWT_CURRENT_PRIVATE_KEY=
# Previous keypair — leave blank outside of rotation windows.
SSO_JWT_PREVIOUS_KID=
SSO_JWT_PREVIOUS_PRIVATE_KEY=

# Generate with: openssl rand -hex 32
SSO_PAIRWISE_SECRET=

# iOS App Attest
SSO_IOS_TEAM_ID=H2N3RZ4J46
SSO_IOS_BUNDLE_ID=org.jomhoor.app
# Use "development" for local/TestFlight; "production" for App Store builds
SSO_IOS_ATTEST_ENV=development

# Android Play Integrity
SSO_ANDROID_PACKAGE_NAME=org.jomhoor.app
# SHA-256 digests (base64) of upload cert + Play-managed cert, comma-separated
SSO_ANDROID_SIGNING_CERT_DIGESTS=
# Set to false locally (debug builds only reach MEETS_BASIC_INTEGRITY)
SSO_ANDROID_REQUIRE_STRONG_INTEGRITY=false

# Deep link — the URL the authorize handler redirects to after challenge is issued.
# For local device testing use the custom scheme (jomhoor://) because
# Universal Links (https://sso.jomhoor.org/auth/sso) require HTTPS + AASA.
# Both values can be the same for local dev.
SSO_DEEPLINK_UNIVERSAL_BASE=jomhoor://auth/sso
SSO_DEEPLINK_CUSTOM_SCHEME=jomhoor://auth/sso
